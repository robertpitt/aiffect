    "@opentelemetry/sdk-trace-node": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "oxfmt": "^0.33.0",
    "oxlint": "^1.48.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18",
    "ws": "^8.18.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
